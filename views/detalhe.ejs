<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <title>Detalhes - <%= time.nome %></title>
  </head>
  //professor so para dizer que "<%= time.cor %>" aparece como sendo o erro mas
  ele funciona perfeitamente bem.
  <body>
    <h1 style="color: <%= time.cor %>"><%= time.nome %></h1>

    <ul>
      <li><strong>ID:</strong> <%= time.id %></li>
      <li><strong>Estádio:</strong> <%= time.estadio %></li>
      <li><strong>Cidade:</strong> <%= time.cidade %></li>
    </ul>

    <a href="/times">Voltar para a lista de times</a>
  </body>
</html>
